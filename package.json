{
  "name": "daora-sanctuary",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "DAORA · 我的迷你道场 — a 3D sanctuary with offline BaZi pillars and an Inner Self Journey.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:pages": "GITHUB_PAGES=true vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:ui": "node tests/smoke.mjs",
    "build:file": "node scripts/standalone.mjs",
    "build:all": "npm run build && npm run build:file",
    "test:standalone": "node tests/standalone.mjs",
    "screenshots": "node tests/capture.mjs",
    "journey:screenshots": "node tests/journey-visual.mjs",
    "journey:test": "node tests/journey-smoke.mjs",
    "test:bazi": "node --test tests/bazi.test.mjs tests/strength.test.mjs tests/ziwei.test.mjs tests/geo.test.mjs",
    "qipan:screenshots": "node tests/qipan-visual.mjs",
    "test:all": "npm run test:bazi && npm run journey:test && npm run test:ui && npm run test:standalone",
    "verify:release": "npm run build:all && npm run test:all",
    "package:handoff": "node scripts/package.mjs"
  },
  "dependencies": {
    "iztro": "^2.5.7",
    "lucide": "^0.468.0",
    "lunar-javascript": "^1.7.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "i18n-iso-countries": "^7.14.0",
    "playwright": "^1.65.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
